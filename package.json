{
  "name": "@channel3/agent-toolkit",
  "version": "0.1.1",
  "description": "Channel3 product search tools for AI agents (Vercel AI SDK, LangChain, Mastra): search 100M+ products and compare live retailer offers.",
  "author": "Channel3",
  "license": "MIT",
  "homepage": "https://channel3.ai/docs/ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/channel3-ai/agent-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/channel3-ai/agent-toolkit/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "langchain",
    "tools",
    "agents",
    "channel3",
    "shopping",
    "product-search",
    "ecommerce",
    "mastra"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@channel3/sdk": "^4.8.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0",
    "@langchain/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.3.5",
    "@types/node": "^26.6.6",
    "ai": "^7.0.164",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
